+
+// Android supplies a USB permission descriptor instead of allowing a bus scan.
+OCH_API int och_open_android_fd(int fd, const char *serial, och_device **out) {
+    return protect([&] {
+        require(out != nullptr, OCH_INVALID, "null device output");
+        *out = nullptr;
+        require(fd >= 0, OCH_INVALID, "invalid Android USB descriptor");
+        auto device = std::make_unique<och_device>();
+        device->open({"android-fd:" + std::to_string(fd), serial ? serial : ""});
+        *out = device.release();
         return OCH_OK;
     });
 }
